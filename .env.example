DATABASE_URL=postgresql+psycopg://facereco:facereco@localhost:5432/facereco

REDIS_URL=redis://localhost:6379/0
INDEXING_STREAM=facereco:indexing
INDEXING_CONSUMER_GROUP=facereco-workers
INDEXING_DEAD_LETTER_STREAM=facereco:indexing:dlq
INDEXING_MAX_DELIVERY_ATTEMPTS=3

S3_ENDPOINT_URL=http://localhost:9000
# Hôte par lequel le navigateur joint le stockage, utilisé pour signer les URLs
# d'images. Vide = identique à S3_ENDPOINT_URL (cas du dev, tout sur localhost).
# En conteneur, l'API joint MinIO par http://minio:9000 mais le navigateur non.
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=facereco-events
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=300

MODEL_VERSION=arcface-r100-v1
INSIGHTFACE_MODEL_PACK=buffalo_l

SIMILARITY_THRESHOLD=0.38
ANN_TOP_K=200
CORROBORATION_LAMBDA=0.02

API_BEARER_TOKEN=change-me-in-production
SEARCH_QUOTA_PER_ACTOR_PER_MINUTE=30

CORS_ALLOWED_ORIGINS=["http://localhost:4200"]
